    <answer><![CDATA[import math


def distancia_pontos(x1, y1, x2, y2):
    d = math.sqrt((x2 - x1) ** 2 + (y2 - y1) ** 2)
    return round(d, 2)


# Programa principal
x1 = float(input("x1: "))
y1 = float(input("y1: "))
x2 = float(input("x2: "))
y2 = float(input("y2: "))
print("Distância:", distancia_pontos(x1, y1, x2, y2))
]]></answer>

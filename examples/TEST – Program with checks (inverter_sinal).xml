    <answer><![CDATA[def inverter_sinal(lista):
    nova_lista = []
    for valor in lista:
        nova_lista.append(-valor)
    return nova_lista


# Programa principal
quantidade = int(input("Quantos números deseja introduzir? "))
numeros = []
for i in range(quantidade):
    numero = int(input("Introduza o número " + str(i + 1) + ": "))
    numeros.append(numero)
print("Lista com os sinais invertidos:", inverter_sinal(numeros))
]]></answer>

    <showsource>0</showsource>
    <answerboxlines>5</answerboxlines>
    <answerboxcolumns>100</answerboxcolumns>
    <answerpreload></answerpreload>
    <globalextra><![CDATA[## The values `a`, `b` and `c` can be the sides of a triangle (each side is shorter than the sum of the other two).
vars: a, b, c in 0..20
## The triangle with sides `a`, `b` and `c` is equilateral.
vars: a, b, c in 1..20
## At least one of the two people is an adult (18 or older).
vars: idade1, idade2 in 0..100
## The year `ano` is a leap year: it is a multiple of 4, but not of 100 unless it is also a multiple of 400.
vars: ano in 1800..2400
forbid: if
## `x` is between 0 and 10, both included. Write it as a chained comparison.
vars: x in -5.0..15.0
require: chain
## The person can get a driving licence: `idade` is greater than {{ age }}, or equal to it.
vars: idade in 0..100
]]></globalextra>
    <useace></useace>
    <resultcolumns></resultcolumns>
    <template></template>
    <iscombinatortemplate></iscombinatortemplate>
    <allowmultiplestdins></allowmultiplestdins>
    <answer><![CDATA[{"exprs": ["[\"a + b > c and a + c > b and b + c > a\", \"a == b == c\", \"idade1 >= 18 or idade2 >= 18\", \"ano % 4 == 0 and (ano % 100 != 0 or ano % 400 == 0)\", \"0 <= x <= 10\", \"idade >= {{ age }}\"]"]}]]></answer>

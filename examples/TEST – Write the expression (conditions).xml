    <name>
      <text><![CDATA[TEST – Write the expression (conditions)]]></text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>For each statement, write a Python expression that gives <code>True</code> when the statement is true and <code>False</code> otherwise. Use only the variables given.</p>]]></text>
    </questiontext>
    <generalfeedback format="html">

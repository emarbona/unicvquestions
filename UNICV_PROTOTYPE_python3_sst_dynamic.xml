<script>
(() => {

    //jshint esversion: 6

    // Every function takes the id of the textarea whose table it works on,
    // because while authoring the script of the sample answer also rebuilds
    // the table of the answer preload.

    const PLUS_ICON = '<svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 1v10M1 6h10"></path></svg>';
    const X_ICON = '<svg aria-hidden="true" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 3l8 8M11 3l-8 8"></path></svg>';

    function byId(id) {
        return document.getElementById(id);
    }

    // Escape a value for use inside a double-quoted HTML attribute.
    function esc(value) {
        return String(value).replace(/&/g, '&amp;').replace(/"/g, '&quot;')
            .replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    /**
     *  Return the value of the ith element of the attribute with the given name
     *  from the data object, if it exists, or the empty string otherwise.
     */
    function getValue(data, name, i) {
        if (data.hasOwnProperty(name) && data[name].length > i) {
            return data[name][i];
        } else {
            return '';
        }
    }

    // Given the value of the var-widths field return a list of the minimum
    // widths of all variable columns. It might be an int or a json list of ints.
    function getVariableWidths(field, num_vars) {
        let widths = [];
        let width = parseInt(field);
        if (isNaN(width)) {
            try {
                widths = JSON.parse(field);
                width = widths[widths.length - 1];
            } catch (e) {
                widths = [];
                width = 100;  // Empty or invalid field: use the default.
            }
        }
        while (widths.length < num_vars) {
            widths.push(width);
        }
        return widths;
    }

    // Get a params record for the given textarea.
    function getParams(textareaId) {
        const num_vars = parseInt(byId(textareaId + '-num_vars').value) || 0;
        return {
            num_vars: num_vars,
            num_rows: parseInt(byId(textareaId + '-num_rows').value) || 1,
            output_width: parseInt(byId(textareaId + '-output_width').value) || 0,
            return_width: parseInt(byId(textareaId + '-return_width').value) || 0,
            var_widths: getVariableWidths(byId(textareaId + '-var_widths').value, num_vars)
        };
    }

    // The number of step rows (all rows except the return-value row, if any).
    function stepRows(params) {
        return params.num_rows - (params.return_width > 0 ? 1 : 0);
    }

    // True if the answer cannot be edited (e.g. when reviewing an attempt).
    function isReadOnly(textareaId) {
        const textarea = byId(textareaId);
        return !!(textarea && (textarea.readOnly || textarea.disabled));
    }

    // The display classes ('cr-explicit' or 'cr-filled-down') of the variable
    // cells, keyed by 'cr-sst-var-<row>-<col>', as stored in the answer.
    function getStates(textareaId) {
        const value = byId(textareaId + '-cr-var-classes').value;
        if (!value) {
            return {};
        }
        try {
            return JSON.parse(value);
        } catch (e) {
            return {};
        }
    }

    function setStates(textareaId, states) {
        const value = JSON.stringify(states);
        // An empty value keeps the serialisation of an empty answer empty.
        byId(textareaId + '-cr-var-classes').value = value === '{}' ? '' : value;
    }

    // Renumber the stored display classes after a row or a column is removed.
    // move(row, col) returns the new [row, col] of a cell, or null to drop it.
    function moveStates(textareaId, move) {
        const states = getStates(textareaId);
        const moved = {};
        for (const key in states) {
            const bits = key.split('-');
            const cell = move(parseInt(bits[bits.length - 2]), parseInt(bits[bits.length - 1]));
            if (cell !== null) {
                moved[`cr-sst-var-${cell[0]}-${cell[1]}`] = states[key];
            }
        }
        setStates(textareaId, moved);
    }

    /**
     * Return the HTML for the SST table element to insert into the DOM.
     * A complication here is that this script runs *after* the HTML-UI has
     * attempted to load all the fields with the values from the textarea.
     * Since the table didn't exist at that time, all the values have been
     * placed into the data-leftovers attribute of the HTML outer div and
     * need to be fetched from there.
     */
    function buildTable(data, params, textareaId) {
        const readOnly = isReadOnly(textareaId);
        const lock = readOnly ? ' readonly' : '';
        const has_output = params.output_width > 0;
        const has_return = params.return_width > 0;
        const num_steps = stepRows(params);
        let html = '<table class="sst2"><thead><tr>' +
            '<th class="sst-step">Step</th><th class="sst-line">Line</th><th class="sst-gap"></th>';

        for (let j = 1; j <= params.num_vars; j++) {
            const name = getValue(data, 'variable_name', j - 1);
            html += `<th class="sst-var"><div class="sst-varhead">
<input id="${textareaId}-cr-sst-var-0-${j}" class="coderunner-ui-element cr-variable-name" name="variable_name" value="${esc(name)}" placeholder="name" aria-label="Name of variable ${j}" style="width:${params.var_widths[j - 1]}px"${lock}>`;
            if (!readOnly) {
                html += `<button type="button" class="sst-x" data-sst-action="remove-var" data-col="${j}" aria-label="Remove variable ${j}" title="Remove this variable">${X_ICON}</button>`;
            }
            html += '</div></th>';
        }
        if (!readOnly) {
            const hint = params.num_vars === 0 ?
                '<span class="sst-empty">No variables yet. Add one for each variable in the program.</span>' : '';
            html += `<th class="sst-addvar"><button type="button" id="${textareaId}-sst-add-var" class="sst-add" data-sst-action="add-var">${PLUS_ICON}Variable</button>${hint}</th>`;
        }
        if (has_output) {
            html += '<th class="sst-gap"></th><th class="sst-out">Printed output</th>';
        }
        html += '<th class="sst-rowdel"></th></tr></thead><tbody>';

        for (let i = 1; i <= params.num_rows; i++) {
            const lineNumber = getValue(data, 'line_number', i - 1);
            const lineCell = `<td class="sst-line"><input class="coderunner-ui-element cr-linenumber" name="line_number" value="${esc(lineNumber)}" aria-label="Line number of step ${i}"${lock}></td><td class="sst-gap"></td>`;
            if (has_return && i === params.num_rows) {
                const returnValue = getValue(data, 'return_value', 0);
                const span = params.num_vars + (readOnly ? 0 : 1) + (has_output ? 2 : 0) + 1;
                html += `<tr class="sst-return-row"><td class="sst-step">${i}</td>${lineCell}
<td class="sst-return" colspan="${span}">Return value:&nbsp;
<input class="coderunner-ui-element cr-return-value" name="return_value" value="${esc(returnValue)}" aria-label="Return value" style="width:${params.return_width}px"${lock}></td></tr>`;
                continue;
            }
            html += `<tr data-row="${i}"><td class="sst-step">${i}</td>${lineCell}`;
            for (let j = 1; j <= params.num_vars; j++) {
                const value = getValue(data, 'variable_value', (i - 1) * params.num_vars + j - 1);
                html += `<td class="sst-var"><input id="${textareaId}-cr-sst-var-${i}-${j}" class="coderunner-ui-element cr-variable cr-undefined" name="variable_value" value="${esc(value)}" aria-label="Value of variable ${j} at step ${i}" style="width:${params.var_widths[j - 1]}px"${lock}></td>`;
            }
            if (!readOnly) {
                html += '<td class="sst-addvar"></td>';
            }
            if (has_output) {
                const output = getValue(data, 'output', i - 1);
                html += `<td class="sst-gap"></td><td class="sst-out"><input class="coderunner-ui-element cr-output" name="output" value="${esc(output)}" aria-label="Printed output of step ${i}" style="width:${params.output_width}px"${lock}></td>`;
            }
            html += '<td class="sst-rowdel">';
            if (!readOnly && num_steps > 1) {
                html += `<button type="button" class="sst-x" data-sst-action="remove-row" data-row="${i}" aria-label="Remove step ${i}" title="Remove this step">${X_ICON}</button>`;
            }
            html += '</td></tr>';
        }
        html += '</tbody></table>';
        return html;
    }

    // Called when a variable value changes. Marks the cell as explicitly
    // entered (or as undefined, if it is now empty) and fills its column down.
    function varChanged(textareaId, element) {
        element.classList.remove('cr-filled-down', 'cr-undefined', 'cr-explicit');
        element.classList.add(element.value.trim() === '' ? 'cr-undefined' : 'cr-explicit');
        const bits = element.id.split('-');
        fillDownColumn(textareaId, parseInt(bits[bits.length - 1]));
    }

    // Work down the given variable column from top to bottom, filling down
    // each explicitly-entered value until the next one, and record the
    // display classes ('cr-undefined', 'cr-filled-down' or 'cr-explicit').
    function fillDownColumn(textareaId, colNum) {
        const states = getStates(textareaId);
        let fillValue = '';
        for (let rowNum = 1; ; rowNum++) {
            const input = byId(`${textareaId}-cr-sst-var-${rowNum}-${colNum}`);
            if (input === null) {
                break;
            }
            const key = `cr-sst-var-${rowNum}-${colNum}`;
            if (input.classList.contains('cr-undefined') && input.value.trim() !== '') {
                // A value with no recorded display class: treat it as explicit.
                input.classList.remove('cr-undefined');
                input.classList.add('cr-explicit');
            }
            let displayClass;
            if (input.classList.contains('cr-explicit')) {
                fillValue = input.value;
                displayClass = 'cr-explicit';
            } else {
                input.value = fillValue;
                displayClass = fillValue === '' ? 'cr-undefined' : 'cr-filled-down';
                input.classList.remove('cr-filled-down', 'cr-undefined', 'cr-explicit');
                input.classList.add(displayClass);
            }
            if (displayClass === 'cr-undefined') {
                delete states[key];
            } else {
                states[key] = displayClass;
            }
        }
        setStates(textareaId, states);
    }

    // Set the display class of each variable cell from the stored classes.
    function loadClasses(textareaId) {
        const states = getStates(textareaId);
        for (const key in states) {
            const input = byId(`${textareaId}-${key}`);
            if (input) { // Ignore unmatchable cells, which happen during editing.
                input.classList.remove('cr-undefined');
                input.classList.add(states[key]);
            }
        }
    }

    // Make the columns of the table wide enough for their contents. The widths
    // in the options panel are only minimum widths; every input in a column
    // gets the width of its longest value.
    function autoSize(textareaId) {
        const params = getParams(textareaId);
        const sst_div = byId(textareaId + '-sst-ui-div');
        const fit = (inputs, minWidth) => {
            let longest = 0;
            inputs.forEach(input => { longest = Math.max(longest, input.value.length); });
            inputs.forEach(input => { input.style.width = `max(${minWidth}px, ${longest + 2}ch)`; });
        };
        for (let j = 1; j <= params.num_vars; j++) {
            const inputs = [];
            for (let i = 0; ; i++) {
                const input = byId(`${textareaId}-cr-sst-var-${i}-${j}`);
                if (input === null) {
                    break;
                }
                inputs.push(input);
            }
            fit(inputs, params.var_widths[j - 1]);
        }
        fit(sst_div.querySelectorAll('.cr-output'), params.output_width);
        fit(sst_div.querySelectorAll('.cr-return-value'), params.return_width);
        fit(sst_div.querySelectorAll('.cr-linenumber'), 48);
    }

    // Return the current contents of the table for the given textarea, in the
    // same format as the serialised answer: a map from element name to the
    // list of values of all elements with that name.
    function collectData(textareaId) {
        const data = {};
        const elements = byId(textareaId + '-sst-ui-div').querySelectorAll('.coderunner-ui-element');
        for (let i = 0; i < elements.length; i++) {
            const name = elements[i].name;
            if (!data.hasOwnProperty(name)) {
                data[name] = [];
            }
            data[name].push(elements[i].value);
        }
        return data;
    }

    // Rebuild the table from the given data, then fill down and resize.
    function rebuild(textareaId, data) {
        buildUI(textareaId, data);
        const params = getParams(textareaId);
        for (let j = 1; j <= params.num_vars; j++) {
            fillDownColumn(textareaId, j);
        }
        autoSize(textareaId);
    }

    // Add a step row at the end of the table (above the return-value row, if
    // any), keeping the contents of the other rows, and move to it.
    function addRow(textareaId) {
        const params = getParams(textareaId);
        const data = collectData(textareaId);
        if (params.return_width > 0) {
            const lineNumbers = data.line_number || [];
            const returnLine = lineNumbers.pop();
            lineNumbers.push('', returnLine === undefined ? '' : returnLine);
            data.line_number = lineNumbers;
        }
        byId(textareaId + '-num_rows').value = params.num_rows + 1;
        rebuild(textareaId, data);
        const lineInputs = byId(textareaId + '-sst-ui-div').querySelectorAll('tr[data-row] .cr-linenumber');
        if (lineInputs.length) {
            lineInputs[lineInputs.length - 1].focus();
        }
    }

    // Remove the given step row (1-based), keeping the contents of the others.
    // Values that were carried over from it are recalculated.
    function removeRow(textareaId, row) {
        const params = getParams(textareaId);
        if (stepRows(params) <= 1 || row < 1 || row > stepRows(params)) {
            return;  // Always keep at least one step row.
        }
        const data = collectData(textareaId);
        (data.line_number || []).splice(row - 1, 1);
        (data.variable_value || []).splice((row - 1) * params.num_vars, params.num_vars);
        (data.output || []).splice(row - 1, 1);
        moveStates(textareaId, (r, c) => r === row ? null : [r > row ? r - 1 : r, c]);
        byId(textareaId + '-num_rows').value = params.num_rows - 1;
        rebuild(textareaId, data);
    }

    // Add a variable column at the right, keeping the contents of the others,
    // and move to its name.
    function addVar(textareaId) {
        const params = getParams(textareaId);
        const data = collectData(textareaId);
        const values = data.variable_value || [];
        const newValues = [];
        for (let r = 0; r < stepRows(params); r++) {
            const rowValues = values.slice(r * params.num_vars, (r + 1) * params.num_vars);
            rowValues.push('');
            newValues.push(...rowValues);
        }
        data.variable_value = newValues;
        data.variable_name = (data.variable_name || []).concat(['']);
        byId(textareaId + '-num_vars').value = params.num_vars + 1;
        rebuild(textareaId, data);
        const nameInput = byId(`${textareaId}-cr-sst-var-0-${params.num_vars + 1}`);
        if (nameInput) {
            nameInput.focus();
        }
    }

    // Remove the given variable column (1-based), keeping the others.
    // A program with no variables has no variable columns at all.
    function removeVar(textareaId, col) {
        const params = getParams(textareaId);
        if (col < 1 || col > params.num_vars) {
            return;
        }
        const data = collectData(textareaId);
        const values = data.variable_value || [];
        const newValues = [];
        for (let r = 0; r < stepRows(params); r++) {
            const rowValues = values.slice(r * params.num_vars, (r + 1) * params.num_vars);
            rowValues.splice(col - 1, 1);
            newValues.push(...rowValues);
        }
        data.variable_value = newValues;
        (data.variable_name || []).splice(col - 1, 1);
        moveStates(textareaId, (r, c) => c === col ? null : [r, c > col ? c - 1 : c]);
        byId(textareaId + '-num_vars').value = params.num_vars - 1;
        rebuild(textareaId, data);
    }

    // Set up, once per table, the handlers for everything inside it. They are
    // attached to the enclosing div, so they survive rebuilding the table.
    function addHandlers(textareaId, sst_div) {
        if (sst_div.crSst2Set) {
            return;
        }
        sst_div.crSst2Set = 1;

        sst_div.addEventListener('click', event => {
            const button = event.target.closest('[data-sst-action]');
            if (!button || isReadOnly(textareaId)) {
                return;
            }
            const action = button.getAttribute('data-sst-action');
            if (action === 'add-var') {
                addVar(textareaId);
            } else if (action === 'remove-var') {
                removeVar(textareaId, parseInt(button.getAttribute('data-col')));
            } else if (action === 'remove-row') {
                removeRow(textareaId, parseInt(button.getAttribute('data-row')));
            }
        });

        sst_div.addEventListener('change', event => {
            if (event.target.classList.contains('cr-variable')) {
                varChanged(textareaId, event.target);
            }
            autoSize(textareaId);
        });

        // Widen the columns as the user types.
        sst_div.addEventListener('input', () => autoSize(textareaId));

        // Enter never submits the form. In a variable cell it confirms the
        // value; in the last step row it adds the next step; in any other
        // step row it moves to the row below.
        sst_div.addEventListener('keydown', event => {
            if (event.keyCode !== 13 || event.target.tagName !== 'INPUT') {
                return;
            }
            event.preventDefault();
            const input = event.target;
            if (input.classList.contains('cr-variable')) {
                varChanged(textareaId, input);
                autoSize(textareaId);
            }
            const tr = input.closest('tr[data-row]');
            if (!tr || isReadOnly(textareaId)) {
                return;
            }
            const row = parseInt(tr.getAttribute('data-row'));
            if (row === stepRows(getParams(textareaId))) {
                addRow(textareaId);
            } else {
                const next = sst_div.querySelector(`tr[data-row="${row + 1}"] .cr-linenumber`);
                if (next) {
                    next.focus();
                }
            }
        });

        // Highlight the step that is being worked on.
        sst_div.addEventListener('focusin', event => {
            const tr = event.target.closest('tbody tr');
            sst_div.querySelectorAll('tbody tr.sst-current').forEach(row => {
                if (row !== tr) {
                    row.classList.remove('sst-current');
                }
            });
            if (tr) {
                tr.classList.add('sst-current');
            }
        });
    }

    // Construct the SST table. If no data is given, the table contents are
    // taken from the current table if there is one (so that rebuilding it
    // keeps what has been typed) or else from the data-leftovers attribute.
    function buildUI(textareaId, data) {
        const params = getParams(textareaId);
        const sst_div = byId(textareaId + '-sst-ui-div');
        if (data === undefined) {
            if (sst_div.querySelector('table.sst2')) {
                data = collectData(textareaId);
            } else {
                const outerDiv = byId("qtype-coderunner-outer-div-" + textareaId);
                const dataLeftovers = outerDiv ? outerDiv.getAttribute('data-leftovers') : '';
                data = dataLeftovers ? JSON.parse(dataLeftovers) : {};
            }
        }
        sst_div.innerHTML = '';  // Purge any existing contents
        sst_div.insertAdjacentHTML('beforeend', buildTable(data, params, textareaId));
        loadClasses(textareaId);
        addHandlers(textareaId, sst_div);
        autoSize(textareaId);
    }

    // Rebuild both the answer and answer preload tables. Called only from the
    // options panel event handlers, which exist only in the sample answer.
    function buildBothUis() {
        buildUI('id_answer');
        if (byId('id_answerpreload-sst-ui-div')) {
            // Copy the options to the answer preload and rebuild that table too.
            // Its numbers of rows and of variables are its own.
            ['var_widths', 'output_width', 'return_width'].forEach(name => {
                byId('id_answerpreload-' + name).value = byId('id_answer-' + name).value;
            });
            buildUI('id_answerpreload');
        }
    }

    // The return-value row is an extra last row of the table, so when it is
    // turned on or off (in the options panel, while authoring) a row is added
    // to or removed from both the answer and the preload tables.
    // Nothing is rebuilt unless an option really changed, so that leaving a
    // field of the panel by clicking a button of a table does not lose the click.
    const optionsNow = () => ['var_widths', 'output_width', 'return_width']
        .map(name => byId('___textareaId___-' + name).value).join('|');
    let lastOptions = optionsNow();
    let hadReturn = getParams('___textareaId___').return_width > 0;
    function optionsChanged() {
        if (optionsNow() === lastOptions) {
            return;
        }
        lastOptions = optionsNow();
        const hasReturn = getParams('___textareaId___').return_width > 0;
        if (hasReturn !== hadReturn) {
            ['id_answer', 'id_answerpreload'].forEach(id => {
                const rowsInput = byId(id + '-num_rows');
                if (rowsInput) {
                    rowsInput.value = Math.max(1, (parseInt(rowsInput.value) || 1) + (hasReturn ? 1 : -1));
                }
            });
            hadReturn = hasReturn;
        }
        buildBothUis();
    }

    buildUI('___textareaId___');  // The initial load of the UI.

    if (isReadOnly('___textareaId___')) {
        byId('___textareaId___-sst-footer').style.display = 'none';
    } else {
        byId('___textareaId___-sst-add-row').addEventListener('click', () => addRow('___textareaId___'));
    }

    // Show the options panel only in the sample answer.
    if ("___textareaId___" === "id_answer") {
        byId('___textareaId___-controlpanel').style.display = "block";
        ['var_widths', 'output_width', 'return_width'].forEach(name => {
            // Rebuild as the author types, and again on change just in case.
            byId('___textareaId___-' + name).oninput = optionsChanged;
            byId('___textareaId___-' + name).onchange = optionsChanged;
        });
    }

})();
